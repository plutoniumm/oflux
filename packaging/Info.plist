<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>                <string>oflux</string>
  <key>CFBundleDisplayName</key>         <string>oflux</string>
  <key>CFBundleIdentifier</key>          <string>ch.manav.oflux</string>
  <key>CFBundleExecutable</key>          <string>oflux</string>
  <key>CFBundleIconFile</key>            <string>oflux</string>
  <key>CFBundlePackageType</key>         <string>APPL</string>
  <!-- Launched from Finder/LaunchServices, open the menu-bar app by default;
       from a terminal, `oflux` (no args) prints usage instead. -->
  <key>LSEnvironment</key>
  <dict>
    <key>OFLUX_LAUNCH</key>               <string>menubar</string>
  </dict>
  <key>CFBundleVersion</key>             <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>  <string>__VERSION__</string>
  <key>LSMinimumSystemVersion</key>      <string>13.0</string>
  <!-- Menu-bar agent: show an NSStatusItem, no Dock icon, no app menu. -->
  <key>LSUIElement</key>                 <true/>
  <key>NSHighResolutionCapable</key>     <true/>
</dict>
</plist>
