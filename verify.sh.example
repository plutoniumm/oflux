#!/usr/bin/env bash
#
#
set -euo pipefail

# ─── fill these in ──────────────────────────────────────────────────────────
APPLE_ID=""                       # e.g. "you@example.com"
APP_PASSWORD=""                   # app-specific password, see header
TEAM_ID="7SKKW27LPH"              # from: Developer ID Application: Manav Seksaria (7SKKW27LPH)
VERSION="${VERSION:-1.0.0}"
# ────────────────────────────────────────────────────────────────────────────

cd "$(dirname "$0")"
DMG="dist/oflux-$VERSION.dmg"
ZIP="dist/oflux-$VERSION-macos-arm64.zip"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

# ─── preflight ──────────────────────────────────────────────────────────────
bold "▸ preflight"

[ -n "$APPLE_ID" ] || die "APPLE_ID is empty — edit $(basename "$0") (see the header for how to get an app-specific password)"
[ -n "$APP_PASSWORD" ] || die "APP_PASSWORD is empty — edit $(basename "$0") (see the header)"

IDENTITY="$(security find-identity -v -p codesigning 2>/dev/null \
  | grep 'Developer ID Application' | head -1 | sed -E 's/.*"(.*)".*/\1/' || true)"
[ -n "$IDENTITY" ] || die "no 'Developer ID Application' certificate in the keychain.
       Create one: Xcode → Settings → Accounts → your Apple ID → Manage Certificates → + → Developer ID Application"
ok "certificate: $IDENTITY"

CERT_TEAM="$(sed -E 's/.*\(([A-Z0-9]{10})\)$/\1/' <<<"$IDENTITY")"
[ "$CERT_TEAM" = "$TEAM_ID" ] || die "TEAM_ID is $TEAM_ID but the certificate is for $CERT_TEAM — fix TEAM_ID above"
ok "team: $TEAM_ID"

[ -x third_party/sd-server ] || { echo "  fetching the Metal engine…"; ./scripts/fetch-engine.sh >/dev/null; }
ok "engine present"

# ─── build + sign ───────────────────────────────────────────────────────────
bold "▸ build + sign"
VERSION="$VERSION" ./scripts/build-app.sh >/dev/null
SIGN_IDENTITY="$IDENTITY" ./scripts/sign-app.sh >/dev/null
ok "dist/oflux.app signed"

# NOTE: capture codesign's output into a variable rather than piping it to
# `grep -q`. Under `set -o pipefail`, grep -q exits at the first match and
# SIGPIPEs codesign, which makes the whole pipeline report failure even though
# the match succeeded — producing false "MISSING" alarms.
SIG="$(codesign -dv --verbose=4 dist/oflux.app 2>&1 || true)"
case "$SIG" in *"(runtime)"*) ok "hardened runtime enabled" ;;
               *) bad "hardened runtime MISSING" ;; esac
case "$SIG" in *"Timestamp="*) ok "secure timestamp present" ;;
               *) bad "secure timestamp MISSING" ;; esac
for f in Contents/MacOS/oflux Contents/Resources/sd-server Contents/Resources/libstable-diffusion.dylib; do
  NSIG="$(codesign -dv "dist/oflux.app/$f" 2>&1 || true)"
  case "$NSIG" in *"TeamIdentifier=$TEAM_ID"*) ok "signed: $(basename "$f")" ;;
                  *) bad "NOT signed by $TEAM_ID: $f" ;; esac
done

# ─── package ────────────────────────────────────────────────────────────────
bold "▸ package"
VERSION="$VERSION" ./scripts/build-dmg.sh >/dev/null
ok "built $DMG"

# ─── notarize ───────────────────────────────────────────────────────────────
bold "▸ notarize (Apple usually takes 1-5 minutes)"
set +e
SUBMIT_OUT="$(xcrun notarytool submit "$DMG" \
  --apple-id "$APPLE_ID" --team-id "$TEAM_ID" --password "$APP_PASSWORD" \
  --wait 2>&1)"
SUBMIT_RC=$?
set -e
echo "$SUBMIT_OUT" | sed 's/^/  /'

if [ $SUBMIT_RC -ne 0 ] || ! grep -q "status: Accepted" <<<"$SUBMIT_OUT"; then
  SUB_ID="$(grep -oE '\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b' <<<"$SUBMIT_OUT" | head -1)"
  if [ -n "$SUB_ID" ]; then
    bold "▸ notarization log (names the offending binary)"
    xcrun notarytool log "$SUB_ID" \
      --apple-id "$APPLE_ID" --team-id "$TEAM_ID" --password "$APP_PASSWORD" 2>&1 | sed 's/^/  /'
  fi
  die "notarization failed — see the log above.
       'Invalid credentials' usually means the app-specific password is wrong or was revoked.
       Generate a fresh one at https://appleid.apple.com → Sign-In and Security → App-Specific Passwords."
fi
ok "Apple accepted the submission"

# ─── staple ─────────────────────────────────────────────────────────────────
bold "▸ staple"
xcrun stapler staple "$DMG" >/dev/null && ok "stapled $DMG"
# Stapling the .app too lets the zip carry the ticket (zips can't be stapled).
xcrun stapler staple dist/oflux.app >/dev/null && ok "stapled dist/oflux.app"
rm -f "$ZIP"
( cd dist && ditto -c -k --keepParent oflux.app "$(basename "$ZIP")" )
ok "built $ZIP"
( cd dist && shasum -a 256 "$(basename "$DMG")" "$(basename "$ZIP")" > SHA256SUMS )
ok "wrote dist/SHA256SUMS"

# ─── final verification ─────────────────────────────────────────────────────
bold "▸ verify"
xcrun stapler validate "$DMG" >/dev/null 2>&1 && ok "ticket stapled to the dmg" || bad "stapler validate failed"

SPCTL="$(spctl -a -vvv -t exec dist/oflux.app 2>&1 || true)"
if grep -q "source=Notarized Developer ID" <<<"$SPCTL"; then
  ok "Gatekeeper: accepted, Notarized Developer ID"
else
  bad "Gatekeeper says:"; echo "$SPCTL" | sed 's/^/      /'
fi

echo
bold "done — artifacts in dist/"
ls -lh "$DMG" "$ZIP" dist/SHA256SUMS 2>/dev/null | awk '{printf "  %-8s %s\n", $5, $9}'
echo
echo "  Install locally:   make install"
echo "  Publish a release: gh release create v$VERSION $DMG $ZIP dist/SHA256SUMS"
